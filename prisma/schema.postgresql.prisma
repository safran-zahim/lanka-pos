generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Staff {
  id        String   @id @default(uuid())
  name      String
  role      String   // admin, manager, cashier
  password  String
  hourlyRate Decimal?
  createdAt DateTime @default(now())
  shifts    Shift[]
  sales     Sale[]
}

model Shift {
  id         String   @id @default(uuid())
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id])
  startTime  DateTime @default(now())
  endTime    DateTime?
  cashStart  Decimal
  cashEnd    Decimal?
}

model Product {
  id          String   @id @default(uuid())
  name        String
  category    String?  // Keep for backward compatibility or migration
  categoryId  String?
  categoryRel Category? @relation(fields: [categoryId], references: [id])
  minStock    Int      @default(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  saleItems   SaleItem[]
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Sale {
  id          String    @id @default(uuid())
  staffId     String
  staff       Staff     @relation(fields: [staffId], references: [id])
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  parentSaleId String?
  parentSale  Sale?     @relation("SaleReturns", fields: [parentSaleId], references: [id])
  returns     Sale[]    @relation("SaleReturns")
  total       Decimal
  subtotal    Decimal?  // optional detailed bill fields
  tax         Decimal?
  discount    Decimal?
  roundOffDiscount Decimal?
  paymentMethod String?
  createdAt   DateTime  @default(now())
  items       SaleItem[]
}

model HeldSale {
  id         Int      @id @default(autoincrement())
  items      Json
  customerId String?
  note       String?
  createdAt  DateTime @default(now())
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  email     String?
  address   String?
  pointsBalance Int  @default(0)
  totalSpend Decimal @default(0)
  createdAt DateTime @default(now())
  sales     Sale[]
  pointsLedger CustomerPointLedger[]
}

model CustomerPointLedger {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  points      Int
  type        String   // EARN, REDEEM, ADJUST
  reference   String?  // sale id or note
  balanceAfter Int?
  createdAt   DateTime @default(now())
}

model AppConfig {
  key                String @id
  subscriptionStatus String @default("active")
  subscriptionPlanId String?
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  updatedAt          DateTime @updatedAt
}

model SubscriptionPlan {
  id        String   @id @default(uuid())
  name      String   @unique
  price     Decimal
  duration  Int      @default(30) // in days
  features  String   // JSON string of enabled features
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  configs   AppConfig[]
}

model Setting {
  key      String @id
  value    Json
  updatedAt DateTime @updatedAt
}
